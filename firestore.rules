rules_version = '2';

// Language Learning App — Firestore Security Rules
//
// Core principles:
//   1. Strict per-user isolation: a user can only ever read/write their own
//      private data (profile, vocabulary, tasks, FRED sessions, usage).
//   2. Server-authoritative scoring: gamification, FRED sessions, public
//      profiles, and challenge scores are written ONLY by Cloud Functions via
//      the Admin SDK (which bypasses these rules). Clients are read-only or
//      blocked on those paths so points/streaks cannot be forged.
//   3. Social collections are membership-gated: only the two users involved in
//      a connection or challenge can read it.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Only allow the listed keys to change on an update.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ================= USERS (private full profile) =================
    match /users/{userId} {
      allow read: if isOwner(userId);

      // On create, the client must not mint points/streaks for itself.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.starPoints == 0
        && request.resource.data.streak.current == 0
        && request.resource.data.mascot.level == 1;

      // The user may edit only profile-level fields. Gamification & mascot
      // fields are absent from this allow-list, so only the Admin SDK can
      // change them.
      allow update: if isOwner(userId) && onlyChanges([
        'displayName', 'photoURL', 'nativeLanguage',
        'targetLanguage', 'fluencyLevel', 'privacy', 'updatedAt'
      ]);

      // Account deletion handled by a dedicated Cloud Function (cleans up
      // subcollections, storage, public profile, connections).
      allow delete: if false;

      // ----- Vocabulary (feature B): fully private, full CRUD -----
      match /vocabulary/{wordId} {
        allow read, write: if isOwner(userId);
      }

      // ----- Tasks (feature A): private; client requests, server completes -----
      match /tasks/{taskId} {
        // Client can create/read/delete its own tasks and set status to
        // 'requested'. The function flips status to generated/error.
        allow read, create, delete: if isOwner(userId);
        allow update: if isOwner(userId)
          && onlyChanges(['title', 'description', 'status', 'updatedAt']);
      }

      // ----- FRED sessions (feature C): owner reads, server writes -----
      match /fred_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false; // Admin SDK only
      }

      // ----- Usage / quota (cost control): owner reads, server writes -----
      match /usage/{periodId} {
        allow read: if isOwner(userId);
        allow write: if false; // Admin SDK only
      }
    }

    // ================= PUBLIC PROFILES (feature F) =================
    // Read by any signed-in user (friends list, search, leaderboards).
    // Written only by the syncPublicProfile Cloud Function.
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    // ================= CONNECTIONS / FRIEND GRAPH (feature F) =================
    match /connections/{connectionId} {
      // Only the two people in the relationship can see it.
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;

      // A request is created by its requester, must include exactly the two
      // participants, and must start as 'pending'.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.requesterId
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.recipientId in request.resource.data.users
        && request.resource.data.status == 'pending';

      // Either party may change only the status (accept/decline/block).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && onlyChanges(['status', 'updatedAt']);

      // Either party may remove the connection (unfriend / cancel request).
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // ================= CHALLENGES (feature G) =================
    match /challenges/{challengeId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Challenger creates the challenge with itself as challenger and a member.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.challengerId
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.status == 'pending'
        && request.resource.data.winnerId == null;

      // Participants may only accept/decline (status). Scores and winnerId are
      // written by the server from verified FRED sessions — never by clients.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && onlyChanges(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ================= DEFAULT DENY =================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
