rules_version = '2';

// Cloud Storage rules — per-user isolation for audio and avatars.
service firebase.storage {
  match /b/{bucket}/o {

    // ----- FRED audio: user can upload/read only their own folder -----
    // Path: audio/{uid}/{sessionId}.webm
    // Raw audio is processed by the fredTurn function then auto-deleted by a
    // bucket lifecycle rule (cost + privacy).
    match /audio/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024            // 10 MB cap
        && request.resource.contentType.matches('audio/.*');
    }

    // ----- Avatars: owner writes, any signed-in user can read -----
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024             // 5 MB cap
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
