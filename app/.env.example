# Client-side config. The anon key is PUBLIC by design — Row Level Security is
# what protects the data, not the secrecy of this key.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or OPENAI_API_KEY in this file:
# anything prefixed VITE_ is bundled into the browser build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
