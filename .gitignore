# Dependencies
node_modules/

# Build output
dist/
app/dist/

# Secrets — NEVER commit
.env
.env.*
!.env.example
**/.env
**/.env.local

# Supabase local state
supabase/.branches/
supabase/.temp/
.supabase/

# Logs / OS / editor
*.log
.DS_Store
*.swp

# TS incremental build cache
*.tsbuildinfo

# Android build output (the project itself IS committed so CI can build it)
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
app/android/.idea/
app/android/app/src/main/assets/public/
*.apk
*.keystore
app/scripts/e2e-results.json
